package = dev.ostrom.cli.platform.vault
linkerOpts = -ldl
---
#include <dlfcn.h>
#include <stddef.h>
#include <string.h>

/*
 * The Secret Service (GNOME Keyring, KWallet) through libsecret, opened at run time with dlopen: the binary runs on a
 * Linux without libsecret, and the store then falls back to its encrypted file. The structures below repeat libsecret's
 * public ABI (SecretSchema, GError), so that no libsecret header is needed to build. Statuses: 0 done, 1 not found,
 * 2 larger than the buffer, 3 any other failure (GError code in *code, -1 when libsecret is not installed).
 */
typedef struct { const char *name; int type; } ostrom_secret_attribute;
typedef struct {
    const char *name;
    int flags;
    ostrom_secret_attribute attributes[32];
    int reserved;
    void *reserved1, *reserved2, *reserved3, *reserved4, *reserved5, *reserved6, *reserved7;
} ostrom_secret_schema;
typedef struct { unsigned int domain; int code; char *message; } ostrom_gerror;

typedef int (*ostrom_store_fn)(const ostrom_secret_schema *, const char *, const char *, const char *, void *,
                               ostrom_gerror **, ...);
typedef char *(*ostrom_lookup_fn)(const ostrom_secret_schema *, void *, ostrom_gerror **, ...);
typedef int (*ostrom_clear_fn)(const ostrom_secret_schema *, void *, ostrom_gerror **, ...);
typedef void (*ostrom_free_fn)(char *);
typedef void (*ostrom_error_free_fn)(ostrom_gerror *);

static void *ostrom_libsecret;
static ostrom_store_fn ostrom_secret_store;
static ostrom_lookup_fn ostrom_secret_lookup;
static ostrom_clear_fn ostrom_secret_clear;
static ostrom_free_fn ostrom_secret_free;
static ostrom_error_free_fn ostrom_error_free;

/* The schema of every Ostrom secret: attributes service and account (SECRET_SCHEMA_ATTRIBUTE_STRING is 0). */
static const ostrom_secret_schema ostrom_schema = {
    "dev.ostrom.cli.Secret", 0, { { "service", 0 }, { "account", 0 }, { NULL, 0 } }, 0,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL
};

/* 1 when libsecret is loaded (it is loaded once), 0 when it is not installed. */
static inline int ostrom_secret_load(void) {
    if (ostrom_libsecret != NULL) return 1;
    void *library = dlopen("libsecret-1.so.0", RTLD_NOW | RTLD_LOCAL);
    if (library == NULL) return 0;
    ostrom_secret_store = (ostrom_store_fn)dlsym(library, "secret_password_store_sync");
    ostrom_secret_lookup = (ostrom_lookup_fn)dlsym(library, "secret_password_lookup_sync");
    ostrom_secret_clear = (ostrom_clear_fn)dlsym(library, "secret_password_clear_sync");
    ostrom_secret_free = (ostrom_free_fn)dlsym(library, "secret_password_free");
    ostrom_error_free = (ostrom_error_free_fn)dlsym(library, "g_error_free");
    if (!ostrom_secret_store || !ostrom_secret_lookup || !ostrom_secret_clear || !ostrom_secret_free ||
        !ostrom_error_free) {
        dlclose(library);
        return 0;
    }
    ostrom_libsecret = library;
    return 1;
}

static inline int ostrom_secret_failed(ostrom_gerror *error, int *code) {
    *code = error->code;
    ostrom_error_free(error);
    return 3;
}

/* Stores `secret` (UTF-8 text) in the default collection. */
static inline int ostrom_secret_write(const char *service, const char *account, const char *secret, int *code) {
    *code = -1;
    if (!ostrom_secret_load()) return 3;
    ostrom_gerror *error = NULL;
    int stored = ostrom_secret_store(&ostrom_schema, NULL, "Ostrom", secret, NULL, &error,
                                     "service", service, "account", account, NULL);
    if (error != NULL) return ostrom_secret_failed(error, code);
    *code = 0;
    return stored ? 0 : 3;
}

static inline int ostrom_secret_read(
    const char *service, const char *account, unsigned char *buffer, int capacity, int *length, int *code) {
    *length = 0;
    *code = -1;
    if (!ostrom_secret_load()) return 3;
    ostrom_gerror *error = NULL;
    char *secret = ostrom_secret_lookup(&ostrom_schema, NULL, &error, "service", service, "account", account, NULL);
    if (error != NULL) return ostrom_secret_failed(error, code);
    *code = 0;
    if (secret == NULL) return 1;
    size_t size = strlen(secret);
    int answer = 0;
    if (size > (size_t)capacity) answer = 2;
    else {
        memcpy(buffer, secret, size);
        *length = (int)size;
    }
    ostrom_secret_free(secret);
    return answer;
}

static inline int ostrom_secret_delete(const char *service, const char *account, int *code) {
    *code = -1;
    if (!ostrom_secret_load()) return 3;
    ostrom_gerror *error = NULL;
    int cleared = ostrom_secret_clear(&ostrom_schema, NULL, &error, "service", service, "account", account, NULL);
    if (error != NULL) return ostrom_secret_failed(error, code);
    *code = 0;
    return cleared ? 0 : 1;
}
