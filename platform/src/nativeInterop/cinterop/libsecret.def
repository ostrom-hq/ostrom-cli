package = run.ostrom.cli.platform.vault
linkerOpts = -ldl -lpthread
---
#include <dlfcn.h>
#include <errno.h>
#include <pthread.h>
#include <stddef.h>
#include <string.h>
#include <time.h>

/*
 * The Secret Service (GNOME Keyring, KWallet) through libsecret, opened at run time with dlopen: the binary runs on a
 * Linux without libsecret, and the store then falls back to its encrypted file. The structures below repeat libsecret's
 * public ABI (SecretSchema, GError), so that no libsecret header is needed to build. Statuses: 0 done, 1 not found,
 * 2 larger than the buffer, 3 refused by the service (GError code in *code; -2 when it did not answer within
 * `timeout_ms`, a locked collection waiting for a prompt nobody answers), 4 no service to ask (libsecret not
 * installed: *code -1; or no session bus, no Secret Service on it: a D-Bus, I/O or spawn error). The caller picks the
 * deadline: short for a hook, long enough for a person to answer an unlock prompt in a terminal.
 */
typedef struct { const char *name; int type; } ostrom_secret_attribute;
typedef struct {
    const char *name;
    int flags;
    ostrom_secret_attribute attributes[32];
    int reserved;
    void *reserved1, *reserved2, *reserved3, *reserved4, *reserved5, *reserved6, *reserved7;
} ostrom_secret_schema;
typedef struct { unsigned int domain; int code; char *message; } ostrom_gerror;

typedef int (*ostrom_store_fn)(const ostrom_secret_schema *, const char *, const char *, const char *, void *,
                               ostrom_gerror **, ...);
typedef char *(*ostrom_lookup_fn)(const ostrom_secret_schema *, void *, ostrom_gerror **, ...);
typedef int (*ostrom_clear_fn)(const ostrom_secret_schema *, void *, ostrom_gerror **, ...);
typedef void (*ostrom_free_fn)(char *);
typedef void (*ostrom_error_free_fn)(ostrom_gerror *);
typedef void *(*ostrom_cancellable_new_fn)(void);
typedef void (*ostrom_object_fn)(void *);
typedef const char *(*ostrom_quark_to_string_fn)(unsigned int);

static void *ostrom_libsecret;
static ostrom_store_fn ostrom_secret_store;
static ostrom_lookup_fn ostrom_secret_lookup;
static ostrom_clear_fn ostrom_secret_clear;
static ostrom_free_fn ostrom_secret_free;
static ostrom_error_free_fn ostrom_error_free;
static ostrom_cancellable_new_fn ostrom_cancellable_new;
static ostrom_object_fn ostrom_cancellable_cancel;
static ostrom_object_fn ostrom_object_unref;
static ostrom_quark_to_string_fn ostrom_quark_to_string;

/* The schema of every Ostrom secret: attributes service and account (SECRET_SCHEMA_ATTRIBUTE_STRING is 0). */
static const ostrom_secret_schema ostrom_schema = {
    "run.ostrom.cli.Secret", 0, { { "service", 0 }, { "account", 0 }, { NULL, 0 } }, 0,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL
};

/* 1 when libsecret is loaded (it is loaded once), 0 when it is not installed. GLib comes with it (its dependencies). */
static inline int ostrom_secret_load(void) {
    if (ostrom_libsecret != NULL) return 1;
    void *library = dlopen("libsecret-1.so.0", RTLD_NOW | RTLD_LOCAL);
    if (library == NULL) return 0;
    ostrom_secret_store = (ostrom_store_fn)dlsym(library, "secret_password_store_sync");
    ostrom_secret_lookup = (ostrom_lookup_fn)dlsym(library, "secret_password_lookup_sync");
    ostrom_secret_clear = (ostrom_clear_fn)dlsym(library, "secret_password_clear_sync");
    ostrom_secret_free = (ostrom_free_fn)dlsym(library, "secret_password_free");
    ostrom_error_free = (ostrom_error_free_fn)dlsym(library, "g_error_free");
    ostrom_cancellable_new = (ostrom_cancellable_new_fn)dlsym(library, "g_cancellable_new");
    ostrom_cancellable_cancel = (ostrom_object_fn)dlsym(library, "g_cancellable_cancel");
    ostrom_object_unref = (ostrom_object_fn)dlsym(library, "g_object_unref");
    ostrom_quark_to_string = (ostrom_quark_to_string_fn)dlsym(library, "g_quark_to_string");
    if (!ostrom_secret_store || !ostrom_secret_lookup || !ostrom_secret_clear || !ostrom_secret_free ||
        !ostrom_error_free || !ostrom_cancellable_new || !ostrom_cancellable_cancel || !ostrom_object_unref ||
        !ostrom_quark_to_string) {
        dlclose(library);
        return 0;
    }
    ostrom_libsecret = library;
    return 1;
}

/* A call under watch: a second thread cancels it when it outlasts OSTROM_SECRET_TIMEOUT_MS. */
typedef struct {
    pthread_mutex_t lock;
    pthread_cond_t ended;
    int timeout_ms;
    int done;
    int timed_out;
    void *cancellable;
    pthread_t thread;
    int watching;
} ostrom_watch;

static void *ostrom_watchdog(void *argument) {
    ostrom_watch *watch = argument;
    struct timespec deadline;
    /* Monotonic: a clock step (NTP, a resumed VM) neither cancels a healthy call nor stretches the deadline. */
    clock_gettime(CLOCK_MONOTONIC, &deadline);
    deadline.tv_sec += watch->timeout_ms / 1000;
    deadline.tv_nsec += (long)(watch->timeout_ms % 1000) * 1000000L;
    if (deadline.tv_nsec >= 1000000000L) { deadline.tv_sec += 1; deadline.tv_nsec -= 1000000000L; }
    pthread_mutex_lock(&watch->lock);
    int waited = 0;
    while (!watch->done && waited != ETIMEDOUT) waited = pthread_cond_timedwait(&watch->ended, &watch->lock, &deadline);
    if (!watch->done) {
        watch->timed_out = 1;
        ostrom_cancellable_cancel(watch->cancellable);
    }
    pthread_mutex_unlock(&watch->lock);
    return NULL;
}

static inline void ostrom_watch_start(ostrom_watch *watch, int timeout_ms) {
    memset(watch, 0, sizeof *watch);
    watch->timeout_ms = timeout_ms;
    pthread_mutex_init(&watch->lock, NULL);
    pthread_condattr_t attributes;
    pthread_condattr_init(&attributes);
    pthread_condattr_setclock(&attributes, CLOCK_MONOTONIC);
    pthread_cond_init(&watch->ended, &attributes);
    pthread_condattr_destroy(&attributes);
    watch->cancellable = ostrom_cancellable_new();
    /* Without a watchdog thread the call still runs, only without its deadline. */
    watch->watching = pthread_create(&watch->thread, NULL, ostrom_watchdog, watch) == 0;
}

/* Ends the watch; returns 1 when the call was cancelled at the deadline. */
static inline int ostrom_watch_end(ostrom_watch *watch) {
    pthread_mutex_lock(&watch->lock);
    watch->done = 1;
    pthread_cond_signal(&watch->ended);
    pthread_mutex_unlock(&watch->lock);
    if (watch->watching) pthread_join(watch->thread, NULL);
    ostrom_object_unref(watch->cancellable);
    pthread_cond_destroy(&watch->ended);
    pthread_mutex_destroy(&watch->lock);
    return watch->timed_out;
}

/*
 * The status for a call that failed with `error` (freed here), or -2 when it was cancelled at the deadline. A D-Bus,
 * I/O or spawn error means there is no Secret Service to ask (4); libsecret's own errors (a locked collection, a
 * protocol error) and a timeout mean a service that runs but refused (3).
 */
static inline int ostrom_secret_failed(ostrom_gerror *error, int timed_out, int *code) {
    int answer = 3;
    if (timed_out) {
        *code = -2;
    } else {
        *code = error->code;
        const char *domain = ostrom_quark_to_string(error->domain);
        if (domain != NULL && strcmp(domain, "secret-error") != 0) answer = 4;
    }
    ostrom_error_free(error);
    return answer;
}

/* Stores `secret` (UTF-8 text) in the default collection. */
static inline int ostrom_secret_write(
    const char *service, const char *account, const char *secret, int timeout_ms, int *code) {
    *code = -1;
    if (!ostrom_secret_load()) return 4;
    ostrom_gerror *error = NULL;
    ostrom_watch watch;
    ostrom_watch_start(&watch, timeout_ms);
    int stored = ostrom_secret_store(&ostrom_schema, NULL, "Ostrom", secret, watch.cancellable, &error,
                                     "service", service, "account", account, NULL);
    int timed_out = ostrom_watch_end(&watch);
    if (error != NULL) return ostrom_secret_failed(error, timed_out, code);
    *code = 0;
    return stored ? 0 : 3;
}

static inline int ostrom_secret_read(const char *service, const char *account, int timeout_ms,
                                     unsigned char *buffer, int capacity, int *length, int *code) {
    *length = 0;
    *code = -1;
    if (!ostrom_secret_load()) return 4;
    ostrom_gerror *error = NULL;
    ostrom_watch watch;
    ostrom_watch_start(&watch, timeout_ms);
    char *secret = ostrom_secret_lookup(&ostrom_schema, watch.cancellable, &error,
                                        "service", service, "account", account, NULL);
    int timed_out = ostrom_watch_end(&watch);
    if (error != NULL) return ostrom_secret_failed(error, timed_out, code);
    *code = 0;
    if (secret == NULL) return 1;
    size_t size = strlen(secret);
    int answer = 0;
    if (size > (size_t)capacity) answer = 2;
    else {
        memcpy(buffer, secret, size);
        *length = (int)size;
    }
    ostrom_secret_free(secret);
    return answer;
}

static inline int ostrom_secret_delete(const char *service, const char *account, int timeout_ms, int *code) {
    *code = -1;
    if (!ostrom_secret_load()) return 4;
    ostrom_gerror *error = NULL;
    ostrom_watch watch;
    ostrom_watch_start(&watch, timeout_ms);
    int cleared = ostrom_secret_clear(&ostrom_schema, watch.cancellable, &error,
                                      "service", service, "account", account, NULL);
    int timed_out = ostrom_watch_end(&watch);
    if (error != NULL) return ostrom_secret_failed(error, timed_out, code);
    *code = 0;
    return cleared ? 0 : 1;
}
